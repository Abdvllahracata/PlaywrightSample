# Copy this file to config/.env and fill in the values (the equivalent of local.runsettings).
# The .env file is never committed.
BASE_URL=https://www.saucedemo.com
API_URL=https://jsonplaceholder.typicode.com
USER_PASSWORD=<test account password>
# Application name shown in the email notification and the HTML report.
# APP_NAME=SauceDemo

# Optional values with built-in defaults. HEADLESS=false shows the browser window, SLOW_MO adds a delay (ms)
# between actions so clicks are visible, and LOGIN_* override the saucedemo test accounts.
# HEADLESS=false
# SLOW_MO=500
# LOGIN_VALID_USER=standard_user
# LOGIN_LOCKED_USER=locked_out_user

# Browser switch (the equivalent of IsSelenoid in local.runsettings): false runs chrome, edge, and firefox on
# this PC; true runs the chrome project on Selenoid and skips edge and firefox, which Selenoid does not provide.
# Screen resolution and VNC are optional and enabled by default.
IS_SELENOID=false
SELENOID_URL=http://<SELENOID_HOST>:4444
SELENOID_USERNAME=<user>
SELENOID_PASSWORD=<password>
SELENOID_CHROME_VERSION=125.0
SELENOID_SESSION_TIMEOUT=2m
# SELENOID_SCREEN_RESOLUTION=1920x1080x24
# SELENOID_ENABLE_VNC=true
IS_ENABLE_VIDEO=false
# Parallel Selenoid sessions; 2 or more made the server close browsers mid-test.
# SELENOID_WORKERS=1

# Email notification after a run (reporters/email-reporter.ts). Disabled by default; npm run test:notify
# enables it for one run. EMAIL_TO accepts several addresses separated by commas. For Gmail, SMTP_PASSWORD
# must be an App Password (Google Account > Security > 2-Step Verification > App passwords), not the
# normal account password. EMAIL_ONLY_ON_FAILURE=true skips passing runs, and EMAIL_DRY_RUN=true saves
# test-results/email-preview.html instead of sending. The test type in the subject comes from the tags in
# --grep (npm run test:notify:smoke gives "Smoke Test", no filter gives "Full Test"); TEST_TYPE overrides it.
# EMAIL_ENABLED=false
# TEST_TYPE=Sanity Test
# EMAIL_ONLY_ON_FAILURE=false
# EMAIL_DRY_RUN=false
EMAIL_TO=<recipient@example.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=<sender@gmail.com>
SMTP_PASSWORD=<app password>
